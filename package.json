{
  "name": "syo-diagramas",
  "private": true,
  "version": "0.1.0",
  "description": "Editor de organigramas y DFDs con validación de las reglas de la cátedra SyO (UNNOBA). 100% estático, usable por agentes.",
  "type": "module",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "validar": "tsx src/cli/index.ts validar",
    "render": "tsx src/cli/index.ts render",
    "reglas": "tsx src/cli/index.ts reglas",
    "nuevo": "tsx src/cli/index.ts nuevo"
  },
  "dependencies": {
    "@codemirror/lang-yaml": "^6.1.0",
    "@codemirror/state": "^6.7.4",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@dagrejs/dagre": "^1.1.0",
    "codemirror": "^6.0.0",
    "d3-flextree": "^2.1.2",
    "d3-hierarchy": "^3.1.2",
    "jspdf": "^3.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "svg2pdf.js": "^2.5.0",
    "yaml": "^2.5.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/d3-hierarchy": "^3.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^7.0.0",
    "vitest": "^4.0.0"
  }
}
